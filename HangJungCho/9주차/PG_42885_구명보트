def solution(people, limit):
    people.sort()
    left = 0
    right = len(people) - 1
    boats = 0
    
    while left <= right:
        # 가장 가벼운 사람과 가장 무거운 사람을 같이 태울 수 있는 경우
        if people[left] + people[right] <= limit:
            left += 1
        
        # 무거운 사람은 항상 탑승
        right -= 1
        boats += 1
        
    return boats