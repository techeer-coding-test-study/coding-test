# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def pairSum(self, head: ListNode | None) -> int:
        stack = []
        a = head
        while a:
            stack.append(a.val)
            a = a.next
        max = 0
        for i in range(len(stack)):
            left = stack[i]
            right = stack[-1-i]
            if(max < (left+right)):
                max = left+ right
        return max

        