# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def constructMaximumBinaryTree(self, nums: list[int]) -> TreeNode | None:
        if not nums:
            return None
        
        max_v = max(nums)
        idx = nums.index(max_v)

        RootNode = TreeNode(max_v)

        RootNode.left = self.constructMaximumBinaryTree(nums[:idx])
        RootNode.right = self.constructMaximumBinaryTree(nums[idx+1:])
        return RootNode    