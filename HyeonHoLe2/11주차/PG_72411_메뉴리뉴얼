import java.util.*;

class Solution {
    public String[] solution(String[] orders, int[] course) {
        boolean[] isCourse = new boolean[11];
        for (int k : course) isCourse[k] = true;

        Map<String, Integer> count = new HashMap<>();
        for (String order : orders) {
            char[] menu = order.toCharArray();
            Arrays.sort(menu);                       
            int len = menu.length;
    
            for (int mask = 1; mask < (1 << len); mask++) {
                if (!isCourse[Integer.bitCount(mask)]) continue;
                StringBuilder sb = new StringBuilder();
                for (int i = 0; i < len; i++) {
                    if ((mask & (1 << i)) != 0) sb.append(menu[i]);
                }
                count.merge(sb.toString(), 1, Integer::sum);
            }
        }

        List<String> answer = new ArrayList<>();
        for (int k : course) {
            int max = 2;
            for (Map.Entry<String, Integer> e : count.entrySet()) {
                if (e.getKey().length() == k) max = Math.max(max, e.getValue());
            }
            for (Map.Entry<String, Integer> e : count.entrySet()) {
                if (e.getKey().length() == k && e.getValue() == max) answer.add(e.getKey());
            }
        }

        Collections.sort(answer);
        return answer.toArray(new String[0]);
    }
}