import java.util.PriorityQueue;

class Solution {
    public int solution(int n, int k, int[] enemy) {
        int count = 0;
        PriorityQueue<Integer> pq = new PriorityQueue<>(); 

        for(int i=0;i<enemy.length;i++){
            pq.add(enemy[i]);             

            if(pq.size() > k){            
                n = n - pq.poll();        
            }

            if(n < 0){                   
                break;
            }
            count++;
        }

        return count;
    }
}