#include <string>
#include <vector>
#include <set>
#include <iostream>

using namespace std;

int solution(vector<vector<string>> clothes) {
    int result = 1;
    for(int i =0;i<clothes.size();i++){
        int count = 0;
        if(clothes[i][1] == "NULL"){
            continue;
        }
        string A = clothes[i][1];
        for(int j=i;j<clothes.size();j++){
            if(clothes[j][1] == A){
                cout << clothes[j][1];
                clothes[j][1] = "NULL";
                count++;
            }
        }
        result = result *(count+1);
    }
    return result-1;
}