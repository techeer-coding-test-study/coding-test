class Solution {
    public String smallestNumber(String pattern) {
        StringBuilder sb = new StringBuilder();
        Deque<Integer> stack = new ArrayDeque<>();
        int n = pattern.length();
        for (int i = 0; i <= n; i++) {
            stack.push(i + 1);                              // 다음으로 작은 숫자
            if (i == n || pattern.charAt(i) == 'I') {        // 감소 구간이 끝나면
                while (!stack.isEmpty()) sb.append(stack.pop()); // 뒤집어서 붙임
            }
        }
        return sb.toString();
    }
}