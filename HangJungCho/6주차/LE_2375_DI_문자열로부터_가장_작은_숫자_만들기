class Solution:
    def smallestNumber(self, pattern: str) -> str:
        result = []
        stack = []
        n = len(pattern)
    
        for i in range(n + 1):
            # 1부터 n+1까지 숫자를 순서대로 스택에 삽입
            stack.append(str(i + 1))
        
            # 'I'를 만나거나 마지막 인덱스에 도달한 경우 스택의 모든 원소를 비움
            if i == n or pattern[i] == 'I':
                while stack:
                    result.append(stack.pop())
                
        return "".join(result)