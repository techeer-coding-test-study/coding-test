#include <string>
#include <vector>

using namespace std;

int solution(string s) {
    int answer = 0;
    for(int i =0;i<s.size();i++){
        if(s[i] == 'z'){
            i += 3;
            answer *= 10;
        }
        else if(s[i] == 'o'){
            i+=2;
            answer = answer * 10 + 1;
        }
        else if(s[i] == 't'){
            if(s[i+1] == 'w'){
                i+=2;
                answer = answer * 10 + 2;
            }
            else{//3
                i+=4;
                answer = answer * 10 + 3;
            }
        }
        else if(s[i] == 'f'){
            if(s[i+1] == 'o'){//4
                i+=3;
                answer = answer * 10 + 4;
            }
            else{
                i+=3;
                answer = answer * 10 + 5;
            }
        }
        else if(s[i] == 's'){
            if(s[i+1] == 'i'){//6
                i+=2;
                answer = answer * 10 + 6;
            }
            else{//7
                i+=4;
                answer = answer * 10 + 7;
            }
        }
        else if(s[i] == 'e'){
            i+=4;
            answer = answer * 10 + 8;
        }
        else if(s[i] == 'n'){
            i+=3;
            answer = answer * 10 + 9;
        }
        else{
            int num = s[i] - '0';
            answer = answer * 10 + num;
        }
    }
    
    return answer;
}