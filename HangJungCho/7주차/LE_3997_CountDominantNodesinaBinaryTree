# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def countDominantNodes(self, root: TreeNode | None) -> int:
        count = 0  # 지배적 노드의 개수를 저장할 변수
        
        # 최댓값을 위로 올려보내는 내부 재귀 함수
        def dfs(node):
            nonlocal count  # 외부 함수의 count 변수를 수정하기 위해 선언
            
            # 노드가 없으면 비교에 영향을 주지 않는 가장 작은 값 반환
            if not node:
                return float('-inf')
            
            # 왼쪽과 오른쪽 자식 트리의 최댓값을 구함
            left_max = dfs(node.left)
            right_max = dfs(node.right)
            
            # 현재 노드가 하위 트리의 최댓값보다 크거나 같으면 카운트 증가
            if node.val >= max(left_max, right_max):
                count += 1
                
            # 현재 노드를 포함한 서브트리의 최댓값을 부모에게 반환
            return max(node.val, left_max, right_max)
        
        # 루트 노드부터 탐색 시작
        dfs(root)
        
        return count