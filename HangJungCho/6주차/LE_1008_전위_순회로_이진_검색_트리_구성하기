# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def bstFromPreorder(self, preorder: list[int]) -> TreeNode | None:
        if not preorder:
            return None

        main = preorder[0]
        RootNode = TreeNode(main)

        leftNode = []
        RightNode = []
        for i in preorder:
            if(i < main):
                leftNode.append(i)
            if(i > main):
                RightNode.append(i)
        
        RootNode.left = self.bstFromPreorder(leftNode)
        RootNode.right = self.bstFromPreorder(RightNode)

        return RootNode