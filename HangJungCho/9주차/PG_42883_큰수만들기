def solution(number, k):
    stack = []
    
    for num in number:
        # 스택에 숫자가 있고, 아직 지울 수 있는 k가 남아있고,
        # 직전 숫자(stack[-1])가 현재 숫자(num)보다 작으면 제거
        while stack and k > 0 and stack[-1] < num:
            stack.pop()
            k -= 1
        stack.append(num)
    
    # 만약 "9876"처럼 이미 내림차순이라 k가 남아있는 경우, 뒤에서 k개만큼 자름
    if k > 0:
        stack = stack[:-k]
        
    return ''.join(stack)